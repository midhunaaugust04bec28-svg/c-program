#include <stdio.h>
#include <string.h>
#include <stdlib.h>

int main() {
    // Allocate memory for the input string (max constraint is 1000)
    char *s = malloc(1001 * sizeof(char));
    scanf("%s", s);

    // Initialize an array of 10 integers with all zeros
    int counts[10] = {0};

    // Iterate through the string
    for (int i = 0; s[i] != '\0'; i++) {
        // Check if the current character is a digit
        if (s[i] >= '0' && s[i] <= '9') {
            // Convert character to integer index by subtracting '0'
            counts[s[i] - '0']++;
        }
    }

    // Print the frequencies separated by spaces
    for (int i = 0; i < 10; i++) {
        printf("%d ", counts[i]);
    }

    free(s);
    return 0;
}
