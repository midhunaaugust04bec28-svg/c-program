#include <stdlib.h>
#include <string.h>
#include <stdbool.h>

// Helper function to find the maximum subsequence of a single array of a given size
int* maxSubarray(int* nums, int numsSize, int size) {
    int* stack = (int*)malloc(size * sizeof(int));
    int top = -1;
    int drop = numsSize - size; // Number of elements we can safely discard

    for (int i = 0; i < numsSize; i++) {
        while (top >= 0 && stack[top] < nums[i] && drop > 0) {
            top--;
            drop--;
        }
        if (top < size - 1) {
            stack[++top] = nums[i];
        } else {
            drop--; // If stack is full, we must discard this element
        }
    }
    return stack;
}

// Helper function to compare two suffixes of arrays to determine which element to pick next
bool greater(int* nums1, int size1, int p1, int* nums2, int size2, int p2) {
    while (p1 < size1 && p2 < size2) {
        if (nums1[p1] > nums2[p2]) return true;
        if (nums1[p1] < nums2[p2]) return false;
        p1++;
        p2++;
    }
    return p1 < size1; // If one finishes, the one with remaining elements is greater
}

// Helper function to merge two subsequences into the largest possible number
int* merge(int* sub1, int size1, int* sub2, int size2, int k) {
    int* res = (int*)malloc(k * sizeof(int));
    int p1 = 0, p2 = 0, r = 0;
    
    while (r < k) {
        if (greater(sub1, size1, p1, sub2, size2, p2)) {
            res[r++] = sub1[p1++];
        } else {
            res[r++] = sub2[p2++];
        }
    }
    return res;
}

// Main function
int* maxNumber(int* nums1, int nums1Size, int* nums2, int nums2Size, int k, int* returnSize) {
    *returnSize = k;
    int* maxResult = (int*)calloc(k, sizeof(int));
    
    // Determine bounds for how many elements we can take from nums1
    int start = (k - nums2Size > 0) ? k - nums2Size : 0;
    int end = (nums1Size < k) ? nums1Size : k;
    
    for (int i = start; i <= end; i++) {
        int len1 = i;
        int len2 = k - i;
        
        int* sub1 = maxSubarray(nums1, nums1Size, len1);
        int* suff2 = maxSubarray(nums2, nums2Size, len2);
        
        int* candidate = merge(sub1, len1, suff2, len2, k);
        
        // If the candidate is lexicographically greater than maxResult, update maxResult
        if (greater(candidate, k, 0, maxResult, k, 0)) {
            memcpy(maxResult, candidate, k * sizeof(int));
        }
        
        free(sub1);
        free(suff2);
        free(candidate);
    }
    
    return maxResult;
}
