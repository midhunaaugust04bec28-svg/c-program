#include <stdlib.h>

// Helper function to count total nodes for array allocation
int countNodes(struct TreeNode* root) {
    if (!root) return 0;
    return 1 + countNodes(root->left) + countNodes(root->right);
}

// Helper function for in-order traversal to populate the sorted array
void inorder(struct TreeNode* root, int* arr, int* index) {
    if (!root) return;
    inorder(root->left, arr, index);
    arr[(*index)++] = root->val;
    inorder(root->right, arr, index);
}

int** closestNodes(struct TreeNode* root, int* queries, int queriesSize, int* returnSize, int** returnColumnSizes) {
    // 1. Count nodes and extract them into a sorted array
    int n = countNodes(root);
    int* treeArray = (int*)malloc(n * sizeof(int));
    int index = 0;
    inorder(root, treeArray, &index);

    // 2. Allocate memory for the output result
    int** result = (int**)malloc(queriesSize * sizeof(int*));
    *returnColumnSizes = (int*)malloc(queriesSize * sizeof(int));
    *returnSize = queriesSize;

    // 3. Process each query using binary search
    for (int i = 0; i < queriesSize; i++) {
        int target = queries[i];
        result[i] = (int*)malloc(2 * sizeof(int));
        (*returnColumnSizes)[i] = 2;

        int low = 0, high = n - 1;
        int min_val = -1;
        int max_val = -1;

        // Binary search for the floor and ceiling
        while (low <= high) {
            int mid = low + (high - low) / 2;
            if (treeArray[mid] == target) {
                min_val = treeArray[mid];
                max_val = treeArray[mid];
                break;
            } else if (treeArray[mid] < target) {
                min_val = treeArray[mid]; // Current mid is a candidate for floor
                low = mid + 1;
            } else {
                max_val = treeArray[mid]; // Current mid is a candidate for ceiling
                high = mid - 1;
            }
        }

        result[i][0] = min_val;
        result[i][1] = max_val;
    }

    // Free the temporary array allocation
    free(treeArray);
    return result;
}
